# Atlas coverage scope for 3md.
#
# The specs govern the library implementations, not the tests, the interactive
# web demo (served on Pages), the examples, or generated build output. Keep
# those out of the coverage denominator. Root-anchored subset of gitignore.

# Tests and conformance fixtures (incl. the colocated JS test suite).
Tests/
uitests/
conformance/
js/test/
rust/tests/

# Interactive demo site (deployed to Pages) and examples.
web/
Examples/

# Docs and dev scripts.
docs/
scripts/
# Interchange harnesses, same role as scripts/ and Examples/.
js/scripts/
rust/examples/

# The nested Sculpt.3md package follows the same scope. Its implementation
# sources stay in the denominator. Tests, docs, and the package manifest do
# not. Patterns are root-anchored, so these are spelled out.
apps/sculpt/Tests/
apps/sculpt/docs/
apps/sculpt/Package.swift

# Build manifests / output / vendored.
Package.swift
.build/
build/
target/
dist/
node_modules/
vendor/
*.min.*
