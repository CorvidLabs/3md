# Local-only verification image: official Swift 6.3 (Ubuntu 24.04) plus binaries
# copied unchanged from the official node, rust and oven/bun images.
FROM node:20-bookworm AS node
FROM rust:1.95-bookworm AS rust
FROM oven/bun:1.4 AS bun
FROM swift:6.3-noble
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
ENV CC=clang CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=clang
